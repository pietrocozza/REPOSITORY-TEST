# Configurazione di Ambrogio.
# Copia questo file con il nome .env (nella stessa cartella) e modifica solo ciò che ti serve.
# Il file .env NON viene caricato su GitHub: è il posto giusto per le impostazioni personali.

# Come Ambrogio ti chiama
AMBROGIO_APPELLATIVO=Pietro

# Percorso di Claude Code, solo se Ambrogio non lo trova da solo
# (per scoprirlo, in PowerShell: where.exe claude)
# AMBROGIO_CLAUDE_PATH=C:\Users\TUONOME\.local\bin\claude.exe

# Modello di Claude Code (vuoto = quello predefinito del tuo abbonamento)
# AMBROGIO_MODELLO=

# Quanto Claude "ragiona" prima di rispondere: low (più rapido), medium, high (più lento e ponderato)
AMBROGIO_EFFORT=low

# 1 = Claude Code resta acceso tra un messaggio e l'altro (più veloce). 0 = si riavvia a ogni messaggio
AMBROGIO_MODALITA_VELOCE=1

# Regola sui costi: Ambrogio usa SOLO il tuo abbonamento Claude.
# Mettere 1 qui permetterebbe di usare chiavi API a consumo: lascialo così salvo decisione esplicita.
AMBROGIO_CONSENTI_API_A_CONSUMO=0

# Porte e cartella dei dati (normalmente non serve cambiarle)
# AMBROGIO_PORTA=8787
# AMBROGIO_CARTELLA_DATI=data

# Voce con accento milanese (Google Gemini). La chiave si crea gratis su https://aistudio.google.com
# ("Get API key"). Senza chiave Ambrogio usa le voci di Edge.
AMBROGIO_GEMINI_CHIAVE=
